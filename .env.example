# Base URL of your Kestra instance (without /api/v1).
KESTRA_URL=http://localhost:8080

# Authentication - set one of:
#   an API token (Enterprise / Cloud service accounts or personal tokens) ...
KESTRA_API_TOKEN=
#   ... or basic auth (Kestra OSS).
KESTRA_USERNAME=
KESTRA_PASSWORD=

# Tenant all tenant-scoped endpoints are called against. OSS always uses "main".
KESTRA_TENANT=main

# "oss" (default) drops every Enterprise-only endpoint; "ee" serves them all.
KESTRA_EDITION=oss

# Optional: comma-separated toolsets (the spec's tags, lowercased with dashes, e.g.
# flows,executions,logs,kv,namespaces,triggers), or "all". Defaults to all.
KESTRA_TOOLSETS=all

# Optional: "true" drops every mutating tool. Defaults to false.
KESTRA_READ_ONLY=false
